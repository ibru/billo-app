        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld unpaid past bills (%2$@) will drop from your overdue list and badge if you reschedule."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld recibos pasados sin pagar (%2$@) desaparecerán de tu lista de vencidos y del globo de la app si reprogramas."
