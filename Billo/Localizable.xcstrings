    "Billo reminds you before each bill is due — no more spreadsheets, email digging, or noisy calendar alerts." : {
      "comment" : "Onboarding reminders subtitle",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billo te avisa antes de que venza cada recibo: se acabaron las hojas de cálculo, las búsquedas en el correo y las alertas ruidosas del calendario."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billo ti avvisa prima della scadenza di ogni bolletta — niente più fogli di calcolo, ricerche tra le email o avvisi invadenti sul calendario."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Billo avisa você antes de cada conta vencer — chega de planilhas, de caçar e-mails e de alertas barulhentos no calendário."
          }
        }
      }
    },
    "Billo uses your income only to show what’s left after bills. It stays on your device and in your private iCloud — never on our servers, and never shared with anyone." : {
      "comment" : "Onboarding income privacy disclosure body",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billo usa tus ingresos solo para mostrarte lo que queda después de los recibos. Se quedan en tu dispositivo y en tu iCloud privado: nunca en nuestros servidores ni compartidos con nadie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billo usa le tue entrate solo per mostrarti quanto resta dopo le bollette. Restano sul tuo dispositivo e nel tuo iCloud privato — mai sui nostri server, e mai condivise con nessuno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Billo usa sua renda apenas para mostrar quanto sobra depois das contas. Ela fica no seu aparelho e no seu iCloud privado — nunca nos nossos servidores, e nunca é compartilhada com ninguém."
          }
        }
      }
    },
    "Bills" : {
      "comment" : "Navigation title in the onboarding income miniature\nNavigation title shown in the onboarding home-screen miniature\nOnboarding mock summary row",
      "localizations" : {
        "es" : {
          "stringUnit" : {
