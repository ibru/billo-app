    "“I’m tired of feeling behind. I just want to know what’s due next.”" : {
      "comment" : "Onboarding empathy user-voice quote",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Me cansa sentir que nunca estoy al día. Solo quiero saber cuál es el próximo vencimiento.»"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Non ne posso più di sentirmi sempre indietro. Voglio solo sapere qual è la prossima scadenza.”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Cansei de viver correndo atrás. Só quero saber o que vence em seguida.”"
          }
        }
      }
    },
